calculation = relax
structure = POSCAR_Si8_displaced
pseudo = Si ../pseudopotentials/Si.pz-vbc.UPF
xc = pz_lda
kpoints = mp 2 2 2

# Energies are Hartree unless the key explicitly says otherwise.
ecut_ha = 10.0
fft_grid = 36 36 36
ewald_width_bohr = 0.70

nelect = auto
nbands = auto
occupations = fermi_dirac
smearing_ev = 0.05

scf_max_iterations = 240
density_tolerance = 1.0e-7
energy_tolerance_ha = 1.0e-9
eigensolver_max_iterations = 100
eigensolver_initial_tolerance_ha = 1.0e-7
eigensolver_tolerance_ha = 2.0e-10
mixing_alpha = 0.10
pulay_max_history = 8
pulay_min_history = 2
pulay_regularization = 1.0e-12

ion_algorithm = bfgs
max_ionic_steps = 30
max_backtracks = 5
force_tolerance_ha_bohr = 2.0e-4
max_step_angstrom = 0.05
bfgs_initial_curvature_ha_bohr2 = 0.10
bfgs_curvature_tolerance = 1.0e-8
energy_increase_tolerance_ha = 1.0e-8

contcar = CONTCAR
trajectory = si8_relaxation.xyz
