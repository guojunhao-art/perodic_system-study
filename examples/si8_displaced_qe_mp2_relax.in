&CONTROL
  calculation = 'relax'
  restart_mode = 'from_scratch'
  prefix = 'si8_displaced_mp2_relax'
  pseudo_dir = './pseudopotentials'
  outdir = './qe_tmp'
  disk_io = 'low'
  tprnfor = .true.
  forc_conv_thr = 4.0d-4
  nstep = 30
/

&SYSTEM
  ibrav = 0
  nat = 8
  ntyp = 1
  ecutwfc = 20.0
  ecutrho = 80.0
  nbnd = 20
  input_dft = 'pz'
  occupations = 'smearing'
  smearing = 'fd'
  degauss = 0.003674932217565
  nr1 = 36
  nr2 = 36
  nr3 = 36
  nr1s = 36
  nr2s = 36
  nr3s = 36
  nosym = .true.
  noinv = .true.
/

&ELECTRONS
  electron_maxstep = 240
  conv_thr = 1.0d-12
  mixing_mode = 'plain'
  mixing_beta = 0.10
  mixing_ndim = 8
  diagonalization = 'david'
/

&IONS
  ion_dynamics = 'bfgs'
/

ATOMIC_SPECIES
Si  28.0855  Si.pz-vbc.UPF

CELL_PARAMETERS angstrom
5.430000000000  0.000000000000  0.000000000000
0.000000000000  5.430000000000  0.000000000000
0.000000000000  0.000000000000  5.430000000000

ATOMIC_POSITIONS crystal
Si  0.000000000000  0.000000000000  0.000000000000
Si  0.000000000000  0.500000000000  0.500000000000
Si  0.500000000000  0.000000000000  0.500000000000
Si  0.500000000000  0.500000000000  0.000000000000
Si  0.253683241252  0.247790055249  0.251473296501
Si  0.250000000000  0.750000000000  0.750000000000
Si  0.750000000000  0.250000000000  0.750000000000
Si  0.750000000000  0.750000000000  0.250000000000

K_POINTS automatic
2 2 2 1 1 1
