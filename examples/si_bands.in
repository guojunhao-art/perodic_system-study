calculation = nscf
structure = POSCAR_Si_diamond
pseudo = Si ../pseudopotentials/Si.pz-vbc.UPF
xc = pz_lda

# Read the converged density written by si_checkpoint_scf.in. A band path is
# a fixed-density NSCF calculation and does not determine a new Fermi level.
checkpoint_input = si.scf.chk
ecut_ha = auto
fft_grid = auto
fft_threads = auto
nelect = auto
nbands = 12
nspin = 1
occupations = zero_t

eigensolver_max_iterations = 150
eigensolver_tolerance_ha = 1.0e-9
eigensolver_empty_tolerance_ha = 1.0e-6
verbosity = compact

# FCC high-symmetry coordinates in the primitive reciprocal basis.
band_points_per_segment = 20
band_point = G 0.000 0.000 0.000
band_point = X 0.500 0.000 0.500
band_point = W 0.500 0.250 0.750
band_point = K 0.375 0.375 0.750
band_point = G 0.000 0.000 0.000
band_point = L 0.500 0.500 0.500
bands_output = si_bands.dat
fatbands_output = si_fatbands.dat
