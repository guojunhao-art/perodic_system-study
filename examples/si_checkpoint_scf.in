calculation = scf
structure = POSCAR_Si_diamond
pseudo = Si ../pseudopotentials/Si.pz-vbc.UPF
xc = pz_lda

# A moderate mesh is sufficient for the self-consistent density.
kpoints = mp 8 8 8
ecut_ha = auto
fft_grid = auto
fft_threads = auto
nelect = auto
nbands = 8
nspin = 1
occupations = zero_t

scf_max_iterations = 150
energy_tolerance_ha = 1.0e-7
eigensolver_initial_tolerance_ha = 1.0e-7
eigensolver_tolerance_ha = 2.0e-10
eigensolver_empty_tolerance_ha = 1.0e-6
mixing_alpha = 0.15
verbosity = compact

checkpoint_output = si.scf.chk
