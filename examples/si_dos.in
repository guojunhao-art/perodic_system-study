calculation = dos
structure = POSCAR_Si_diamond
pseudo = Si ../pseudopotentials/Si.pz-vbc.UPF
xc = pz_lda

# DOS quality is controlled primarily by this Brillouin-zone mesh.
kpoints = mp 8 8 8
ecut_ha = auto
fft_grid = auto
fft_threads = auto
nelect = auto

# Include enough empty bands to cover the requested conduction-band window.
nbands = 12
nspin = 1
occupations = zero_t

scf_max_iterations = 150
energy_tolerance_ha = 1.0e-7
eigensolver_initial_tolerance_ha = 1.0e-7
eigensolver_tolerance_ha = 2.0e-10
mixing_alpha = 0.15
verbosity = compact

dos_smearing_ev = 0.10
dos_points = 2001
dos_energy_min_ev = -10.0
dos_energy_max_ev = 10.0
dos_output = si_dos.dat
