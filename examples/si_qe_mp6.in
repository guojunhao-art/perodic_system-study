&CONTROL
  calculation = 'scf'
  restart_mode = 'from_scratch'
  prefix = 'si_mp6'
  pseudo_dir = './pseudopotentials'
  outdir = './qe_tmp'
  disk_io = 'low'
/

&SYSTEM
  ibrav = 0
  nat = 1
  ntyp = 1

  ! pwdft: ecut_ha = 10.0; QE uses Ry.
  ecutwfc = 20.0
  ecutrho = 80.0

  ! Match pwdft's automatically selected eight bands.
  nbnd = 8
  input_dft = 'pz'
  occupations = 'smearing'
  smearing = 'fd'
  ! 0.05 eV expressed in Ry.
  degauss = 0.003674932217565

  ! Match pwdft's explicit 36 x 36 x 36 real-space grid.
  nr1 = 36
  nr2 = 36
  nr3 = 36
  nr1s = 36
  nr2s = 36
  nr3s = 36

  ! Keep the complete equally weighted mesh, as in pwdft.
  nosym = .true.
  noinv = .true.
/

&ELECTRONS
  electron_maxstep = 240
  conv_thr = 1.0d-12
  mixing_mode = 'plain'
  mixing_beta = 0.10
  mixing_ndim = 8
  diagonalization = 'david'
/

ATOMIC_SPECIES
Si  28.0855  Si.pz-vbc.UPF

! POSCAR_Si uses 6.35012652804 Angstrom, which is 12.0 Bohr.
CELL_PARAMETERS bohr
12.0  0.0   0.0
0.0   12.0  0.0
0.0   0.0   12.0

ATOMIC_POSITIONS crystal
Si  0.5  0.5  0.5

K_POINTS automatic
6 6 6 1 1 1
