calculation = relax_bands
structure = POSCAR_Si_diamond_displaced
pseudo = Si ../pseudopotentials/Si.pz-vbc.UPF
xc = pz_lda

# BFGS and the final static SCF both use this uniform mesh. The final SCF
# additionally enlarges an automatic FFT grid when required by the path.
kpoints = gamma 4 4 4
ecut_ha = auto
fft_grid = auto
fft_threads = auto
nelect = auto
nbands = 8
nspin = 1
occupations = zero_t

scf_max_iterations = 150
energy_tolerance_ha = 1.0e-7
eigensolver_initial_tolerance_ha = 1.0e-7
eigensolver_tolerance_ha = 2.0e-10
mixing_alpha = 0.15
verbosity = compact

ion_algorithm = bfgs
max_ionic_steps = 30
max_backtracks = 5
force_tolerance_ha_bohr = 2.0e-4
max_step_angstrom = 0.03
bfgs_initial_curvature_ha_bohr2 = 0.10
contcar = CONTCAR
trajectory = si_relax_bands.xyz

band_points_per_segment = 20
band_point = G 0.000 0.000 0.000
band_point = X 0.500 0.000 0.500
band_point = W 0.500 0.250 0.750
band_point = K 0.375 0.375 0.750
band_point = G 0.000 0.000 0.000
band_point = L 0.500 0.500 0.500
bands_output = si_relaxed_bands.dat
