calculation = relax
structure = POSCAR_direct_selective
pseudo = Si minimal_sp_nc.upf
pseudo = H minimal_local_nc.upf
xc = pz_lda
kpoints = gamma

ecut_ha = 10.0
fft_grid = 24 26 28
nelect = auto
nbands = auto
occupations = zero_t

ion_algorithm = bfgs
max_ionic_steps = 37
max_backtracks = 4
force_tolerance_ha_bohr = 3.0e-4
max_step_angstrom = 0.075
bfgs_initial_curvature_ha_bohr2 = 0.20
bfgs_curvature_tolerance = 2.0e-8
energy_increase_tolerance_ha = 5.0e-9
contcar = test.CONTCAR
trajectory = test-relax.xyz
